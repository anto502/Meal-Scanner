{
  "expo": {
    "name": "Meal Scanner",
    "slug": "meal-scanner",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mycompany.mealscanner",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      ["expo-image-picker", { "cameraPermission": "Allow Meal Scanner to take photos of your meals." }],
      ["@react-native-google-signin/google-signin"]
    ]
  }
}
